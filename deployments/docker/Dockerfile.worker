FROM golang:1.26.5-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
COPY apps ./apps
COPY examples ./examples
RUN go build -o /out/wreckr-worker ./apps/api/cmd/worker

FROM alpine:3.21

COPY --from=grafana/k6:latest /usr/bin/k6 /usr/bin/k6

RUN adduser -D -H wreckr
USER wreckr
WORKDIR /app
COPY --from=build /out/wreckr-worker /app/wreckr-worker
ENTRYPOINT ["/app/wreckr-worker"]
